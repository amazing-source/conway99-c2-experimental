	function fsubmit_findfast(){
		myform=document.forms['findfast'];
		if(myform.syear.value=='' && myform.svolume.value=='' && myform.sissue.value=='' && myform.spage.value==''){
			alert('Введите данные для поиска');
			return false;
		}
		return true;
	}
	
	function fsubmit_findfast_do(){
		if(fsubmit_findfast()){
			document.forms['findfast'].submit();
			return true;
		}
		else{
			return false;
		}
	}
	
	</script>
